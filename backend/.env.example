# Backend environment variables — PRODUCTION
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/stefmat?schema=public"

# JWT
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"

# Upload settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880